 @media (prefers-reduced-motion: reduce) {
   .rv-share-btn, .rv-toast { transition-duration: .01ms !important; }
 }
+
+
+/* ====================================================================
+   SECTION STACK - every homepage section pins and the next one slides up
+   over it (the hero already does this). --stack-top is set per section by
+   script.js (section 9): 0 for short sections, (viewport - height) for tall
+   ones so their whole content is readable before they are covered.
+   Sticky is composited by the browser, so no scroll handler is involved.
+   Deliberately NO transform / will-change on the sections: either would
+   make them the containing block of the fixed .rv-toast and break it.
+   ==================================================================== */
+.page-body { isolation: isolate; }
+.page-body > section {
+  position: sticky;
+  top: var(--stack-top, 0px);
+  box-shadow: 0 -1px 0 rgba(0, 0, 0, .06), 0 -28px 60px -34px rgba(0, 0, 0, .45);
+}
+/* later sections paint over earlier ones */
+.page-body > section:nth-child(1) { z-index: 1; }
+.page-body > section:nth-child(2) { z-index: 2; }
+.page-body > section:nth-child(3) { z-index: 3; }
+.page-body > section:nth-child(4) { z-index: 4; }
+.page-body > section:nth-child(5) { z-index: 5; }
+.page-body > section:nth-child(6) { z-index: 6; }
+.page-body > section:nth-child(7) { z-index: 7; }
+.page-body > section:nth-child(8) { z-index: 8; }
+.page-body > section:nth-child(n+9) { z-index: 9; }
+
+/* safety nets: no stacking where it can't work or isn't wanted */
+@media (max-height: 460px), print {
+  .page-body > section { position: relative; top: auto; box-shadow: none; z-index: auto; }
+}
