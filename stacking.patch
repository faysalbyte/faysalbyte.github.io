+  /* ---------- 9. global sticky card-stack ----------
+     CSS (home.css, "SECTION STACK") makes every .page-body > section sticky.
+     A section taller than the screen must NOT pin at top:0 (its lower half
+     would be hidden), so each one pins when its BOTTOM meets the screen
+     bottom: top = viewportHeight - sectionHeight (negative). Short sections
+     pin at 0. The next section then slides over it. */
+  (function stack() {
+    var sections = $$(".page-body > section");
+    if (!sections.length) return;
+    var queued = false;
+    var last = [];
+
+    function apply() {
+      queued = false;
+      var vh = root.clientHeight || window.innerHeight;
+      for (var i = 0; i < sections.length; i++) {
+        var top = Math.min(0, Math.round(vh - sections[i].offsetHeight));
+        if (last[i] !== top) { last[i] = top; sections[i].style.setProperty("--stack-top", top + "px"); }
+      }
+    }
+    function request() { if (!queued) { queued = true; requestAnimationFrame(apply); } }
+
+    apply();
+    window.addEventListener("resize", request, { passive: true });
+    window.addEventListener("orientationchange", request);
+    window.addEventListener("load", request);
+    window.addEventListener("pageshow", request);
+    if (document.fonts && document.fonts.ready) document.fonts.ready.then(request);
+    if ("ResizeObserver" in window) {
+      var ro = new ResizeObserver(request);
+      sections.forEach(function (sec) { ro.observe(sec); });
+    }
+
+    /* in-page links: jump to the section's natural position, not its pinned one */
+    function goTo(id, smooth) {
+      var sec = id && document.getElementById(id);
+      if (!sec) return false;
+      var host = sec.closest(".page-body > section");
+      if (!host) return false;
+      var y = window.pageYOffset || root.scrollTop;
+      var navH = parseFloat(getComputedStyle(document.body).getPropertyValue("--nav-h")) || 76;
+      var target = naturalTop(host, y) - navH + 1 + (sec === host ? 0 : sec.getBoundingClientRect().top + y - host.getBoundingClientRect().top);
+      window.scrollTo({ top: Math.max(0, target), behavior: smooth && !motion.matches ? "smooth" : "auto" });
+      return true;
+    }
+    document.addEventListener("click", function (e) {
+      var a = e.target.closest && e.target.closest("a[href^=\"#\"]");
+      if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button) return;
+      var id = decodeURIComponent(a.getAttribute("href").slice(1));
+      if (goTo(id, true)) { e.preventDefault(); history.pushState(null, "", "#" + id); }
+    });
